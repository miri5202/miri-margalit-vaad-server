# העתיקו קובץ זה לקובץ בשם .env ומלאו ערכים אמיתיים
# ב-Windows:  copy .env.example .env

# כתובת מסד הנתונים PostgreSQL
# בענן (Neon / Render):  postgresql://user:password@host/dbname?sslmode=require
# מקומי:                 postgresql://postgres:password@localhost:5432/vaad_bait
DATABASE_URL=postgresql://postgres:password@localhost:5432/vaad_bait

# מחרוזת סודית לחתימת הטוקנים - להחליף במחרוזת ארוכה ואקראית
JWT_SECRET=change-me-to-a-long-random-string

# כמה זמן ההתחברות תקפה
JWT_EXPIRES_IN=7d

# הפורט שהשרת מאזין לו
PORT=5000

# כתובת צד הלקוח (React) - בשביל CORS
CLIENT_URL=http://localhost:5173
